{
  "name": "express-ts-template",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "format": "prettier --config .prettierrc '{src,tests}/**/*.ts' --write",
    "build": "tsc",
    "lint": "eslint .",
    "dev": "tsx --watch --env-file-if-exists=.env ./src/main.ts",
    "start": "node --env-file-if-exists=.env ./dist/main.js",
    "test": "vitest run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Davilez42/Api-nodejs-ts-template.git"
  },
  "author": "",
  "license": "MIT",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.5.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  }
}